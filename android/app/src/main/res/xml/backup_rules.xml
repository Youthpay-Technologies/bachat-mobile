<?xml version="1.0" encoding="utf-8"?>
<!-- Account snapshots, offline writes, sessions and PINs stay on this device.
     Cloud records return only after sign-in; the new device creates its own PIN. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
